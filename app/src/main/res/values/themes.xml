<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!--
        Tema minimo de plataforma. El aspecto real de la aplicacion se define en
        Compose (presentation/theme/Theme.kt); este tema solo evita el parpadeo
        blanco durante el arranque y elimina la ActionBar heredada.
    -->
    <style name="Theme.CacaoScan" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/cacao_background</item>
        <item name="android:statusBarColor">@color/cacao_brown</item>
        <item name="android:windowLightStatusBar">false</item>
    </style>
</resources>
